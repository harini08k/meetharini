---
// One place that decides "real photo or placeholder".
// To add a photo: drop a file named like IMG-03.jpg (or IMG-03-roster.png) into src/assets/photos.
// Astro resizes it and strips location data from the copy that ships to the site.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id?: string; // e.g. "IMG-03"
  src?: ImageMetadata; // a photo uploaded straight from the editor
  alt: string;
  sizes?: string;
  loading?: 'lazy' | 'eager';
}

const { id, src, alt, sizes = '(min-width: 960px) 520px, 90vw', loading = 'lazy' } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/photos/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const found = id
  ? Object.entries(files).find(([path]) => path.split('/').pop()!.toUpperCase().startsWith(id.toUpperCase()))?.[1].default
  : undefined;
const image = src ?? found;
---

{
  image ? (
    <Image src={image} alt={alt} widths={[480, 800, 1200]} sizes={sizes} loading={loading} quality={80} />
  ) : (
    <div class="ph" role="img" aria-label={alt}>
      <span>{alt}</span>
      {id && <span>{id}, coming soon</span>}
    </div>
  )
}
