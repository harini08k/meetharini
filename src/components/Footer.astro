---
// Footer: the email line and the build date. The date is when the site was last built, so the daily rebuild keeps it fresh.
// The email address is split so it isn't sitting in the page as one plain string.
import { site } from '../data/site';
const built = new Date().toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const [u, d] = site.email.split('@');
---

<footer class="foot">
  <p class="foot__talk">
    Still scrolling? We should probably talk.{' '}
    <a class="email-link" href="#" data-u={u} data-d={d}>Email me</a>
  </p>
  <p class="foot__meta">
    <span>Built by me with Astro.</span>
    <span>Last deployed {built}.</span>
    <a href={site.links.repo}>Source on GitHub</a>
  </p>
</footer>

<style>
  .foot {
    grid-column: 2;
    padding: 36px 0 48px;
    border-top: 1px solid var(--rule);
    max-width: var(--body-max);
  }

  .foot__talk {
    font-size: var(--step-1);
    margin-bottom: 10px;
  }

  .foot__talk a {
    font-weight: 600;
  }

  .foot__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    margin: 0;
    font-size: var(--step--1);
    color: var(--fg-2);
  }
</style>

<script>
  document.querySelectorAll<HTMLAnchorElement>('a.email-link').forEach((a) => {
    a.href = `mailto:${a.dataset.u}@${a.dataset.d}`;
  });
</script>
