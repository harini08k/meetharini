---
// "More things I've built": expandable cards (Pixorama, Multimodal Agentic App, Document Summarizer).
// Each card is a native <details>, so it works without JavaScript. Content is `moreProjects` in src/data/resume.ts.
import Photo from './Photo.astro';
import { moreProjects } from '../data/resume';
---

<section class="sec" id="more" data-knot aria-labelledby="more-h">
  <h2 class="sec-label" id="more-h">More things I've built</h2>
  <div class="sec-body">
    <div class="more">
      {
        moreProjects.map((p) => (
          <details class="proj">
            <summary>
              <span class="proj__name">{p.name}</span>
              <span class="proj__line">{p.line}</span>
              <ul class="chip-row">
                {p.stack.map((s) => (
                  <li class="chip">{s}</li>
                ))}
              </ul>
              <span class="proj__open" aria-hidden="true">
                <span class="proj__open-closed">Open</span>
                <span class="proj__open-opened">Close</span>
              </span>
            </summary>
            <div class="proj__body">
              <div>
                <h3 class="proj__h">Inside</h3>
                <p>{p.inside}</p>
                {p.mine && (
                  <>
                    <h3 class="proj__h">What was mine</h3>
                    <p>{p.mine}</p>
                  </>
                )}
                <a href={p.href}>Code on GitHub</a>
              </div>
              <Photo id={p.image} alt={`${p.name} screenshot`} />
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .more {
    display: grid;
    gap: 12px;
  }

  .proj {
    border: 1px solid var(--rule);
    border-radius: var(--radius-m);
    background: var(--surface);
    transition: border-color 200ms;
  }

  .proj:hover,
  .proj[open] {
    border-color: var(--fg);
  }

  .proj summary {
    list-style: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 6px 16px;
    padding: 18px 20px;
    cursor: pointer;
  }

  .proj summary::-webkit-details-marker {
    display: none;
  }

  .proj__name {
    grid-column: 1;
    font-size: var(--step-2);
    font-weight: 650;
    font-stretch: 84%;
    line-height: 1.1;
  }

  .proj__line {
    grid-column: 1;
    color: var(--fg-2);
  }

  .proj summary .chip-row {
    grid-column: 1;
    margin-top: 6px;
  }

  .proj__open {
    grid-column: 2;
    grid-row: 1;
    align-self: start;
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--silk);
  }

  .proj__open-opened,
  .proj[open] .proj__open-closed {
    display: none;
  }

  .proj[open] .proj__open-opened {
    display: inline;
  }

  .proj__body {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 20px;
    padding: 0 20px 20px;
    animation: open 240ms var(--ease);
  }

  .proj__h {
    font-size: var(--step-0);
    font-stretch: 90%;
    margin: 6px 0 4px;
  }

  .proj__body p {
    color: var(--fg-2);
  }

  .proj__body a {
    font-weight: 560;
  }

  .proj__body .ph {
    border-radius: var(--radius-s);
  }

  @keyframes open {
    from {
      opacity: 0;
    }
  }

  @media (max-width: 680px) {
    .proj__body {
      grid-template-columns: 1fr;
    }
  }
</style>
