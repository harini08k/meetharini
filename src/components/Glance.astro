---
// "The 30-second version": a briefing card that only shows in Recruiter mode (CSS in global.css hides it otherwise).
// It lists what a recruiter checks first and links into the full sections. The email link is built in the script
// so the address isn't sitting in the page as one plain string.
import { existsSync } from 'node:fs';
import { site } from '../data/site';

const email = site.email.split('@');
const hasResume = existsSync(new URL('../../public/resume.pdf', import.meta.url));

const facts = [
  { label: 'Looking for', text: 'SDE, full-stack, backend, mobile or AI internships. Now and 2027.', href: '#top', cta: 'Email me', mail: true },
  { label: 'Best proof', text: "5th place, solo, in Serverpod's Build Something Real hackathon. BenchCall has 1,000+ automated tests.", href: '#benchcall', cta: 'See BenchCall' },
  { label: 'Also built', text: 'ReachInbox Scheduler: sends each email once, on time, even if the server crashes.', href: '#reachinbox', cta: 'See ReachInbox' },
  { label: 'Experience', text: 'Full Stack Developer intern at SpearStreamZ Technologies, Dec 2025 to Mar 2026.', href: '#work', cta: 'See the work' },
  { label: 'Certified', text: 'AWS Certified AI Practitioner (AIF-C01), July 2026.', href: '/scrapbook/#tech', cta: 'See the scrapbook' },
  { label: 'Studying', text: 'B.E. Computer Science at SVCE, Chennai (Anna University). Graduating June 2028.', href: '#about', cta: 'More about me' },
];
---

<section class="glance" id="glance" aria-labelledby="glance-h" tabindex="-1">
  <div class="glance__card">
    <p class="glance__tag">Recruiter mode is on</p>
    <h2 class="glance__h" id="glance-h">Harini Karthikeyan, the 30-second version</h2>
    <p class="glance__lead">Everything below is open and in one place. Here's what to check first.</p>

    <ul class="glance__grid">
      {
        facts.map((f, i) => (
          <li class="glance__item" style={`--i:${i}`}>
            <span class="glance__label">{f.label}</span>
            <p>{f.text}</p>
            <a href={f.href} class={f.mail ? 'glance__mail' : undefined} data-u={f.mail ? email[0] : undefined} data-d={f.mail ? email[1] : undefined}>{f.cta}</a>
          </li>
        ))
      }
    </ul>

    <div class="btn-row glance__actions">
      {hasResume && <a class="btn btn--primary" href={site.resume}>Résumé (PDF)</a>}
      <a class="btn glance__mail" href="#top" data-u={email[0]} data-d={email[1]}>Email me</a>
      <a class="btn" href={site.links.linkedin} rel="me">LinkedIn</a>
      <a class="btn" href={site.links.github} rel="me">GitHub</a>
      <button class="glance__exit" type="button" data-recruiter-trigger>Back to the full story</button>
    </div>
  </div>
</section>

<style>
  .glance {
    display: none;
    grid-column: 1 / -1;
    padding: 36px 24px 8px;
    scroll-margin-top: 72px;
  }

  :global(html[data-recruiter]) .glance {
    display: block;
  }

  .glance:focus {
    outline: none;
  }

  .glance__card {
    max-width: 1000px;
    margin: 0 auto;
    padding: 32px 32px 28px;
    border: 1.5px solid var(--ink);
    border-radius: var(--radius-m);
    background: var(--surface, #fff);
    box-shadow: 8px 8px 0 var(--silk-tint);
  }

  .glance__tag {
    display: inline-block;
    margin: 0 0 12px;
    padding: 3px 12px;
    border-radius: 999px;
    background: var(--silk-tint);
    color: var(--silk);
    font-size: var(--step--1);
    font-weight: 600;
  }

  .glance__h {
    margin: 0 0 6px;
    font-size: var(--step-3);
    font-stretch: 80%;
    line-height: 1.05;
  }

  .glance__lead {
    margin: 0 0 24px;
    color: var(--fg-2);
  }

  .glance__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 14px;
    margin: 0 0 26px;
    padding: 0;
    list-style: none;
  }

  .glance__item {
    padding: 16px 18px;
    border: 1px solid var(--rule);
    border-radius: var(--radius-m);
    background: var(--bg);
  }

  .glance__label {
    display: block;
    margin-bottom: 4px;
    color: var(--silk);
    font-size: var(--step--1);
    font-weight: 700;
  }

  .glance__item p {
    margin: 0 0 8px;
    line-height: 1.45;
  }

  .glance__item a {
    font-size: var(--step--1);
    font-weight: 560;
    color: var(--fg);
    text-decoration-color: var(--silk);
    text-underline-offset: 3px;
  }

  .glance__actions {
    align-items: center;
  }

  .glance__exit {
    margin-left: auto;
    padding: 0;
    border: 0;
    background: none;
    color: var(--fg-2);
    font: inherit;
    font-size: var(--step--1);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .glance__exit:hover,
  .glance__exit:focus-visible {
    color: var(--fg);
    text-decoration-color: var(--silk);
  }

  /* The one moment of motion: the facts deal in one after another when the mode switches on. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html[data-recruiter]) .glance__card {
      animation: glance-card 420ms var(--ease) both;
    }

    :global(html[data-recruiter]) .glance__item {
      animation: glance-in 460ms var(--ease) both;
      animation-delay: calc(140ms + var(--i) * 70ms);
    }
  }

  @keyframes glance-card {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
  }

  @keyframes glance-in {
    from {
      opacity: 0;
      transform: translateY(14px) rotate(-1deg);
    }
  }

  @media (max-width: 640px) {
    .glance {
      padding: 20px 12px 4px;
    }

    .glance__card {
      padding: 22px 18px;
      box-shadow: 5px 5px 0 var(--silk-tint);
    }

    .glance__exit {
      margin-left: 0;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLAnchorElement>('a.glance__mail').forEach((a) => {
    a.href = `mailto:${a.dataset.u}@${a.dataset.d}`;
  });
</script>
