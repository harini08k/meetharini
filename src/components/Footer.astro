---
// Footer: the email line, then the copyright and cookie-preferences row (Legal.astro).
// The email address is split so it isn't sitting in the page as one plain string.
import Legal from './Legal.astro';
import { site } from '../data/site';
const [u, d] = site.email.split('@');
---

<footer class="foot">
  <p class="foot__talk">
    Still scrolling? We should probably talk.{' '}
    <a class="email-link" href="#" data-u={u} data-d={d}>Email me</a>
  </p>
  <Legal />
</footer>

<style>
  .foot {
    grid-column: 2;
    padding: 36px 0 48px;
    border-top: 1px solid var(--rule);
    max-width: var(--body-max);
  }

  .foot__talk {
    font-size: var(--step-1);
    margin-bottom: 18px;
  }

  .foot__talk a {
    font-weight: 600;
  }

</style>

<script>
  document.querySelectorAll<HTMLAnchorElement>('a.email-link').forEach((a) => {
    a.href = `mailto:${a.dataset.u}@${a.dataset.d}`;
  });
</script>
